{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing basic account information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "Email address of the user"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL of the user"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of profile creation"
        }
      },
      "required": ["userId", "displayName"]
    },
    "WelcomeNote": {
      "title": "WelcomeNote",
      "description": "A personal welcome note or message created by a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the author"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the author"
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "Content of the welcome note"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["userId", "authorName", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of private user profile records"
    },
    "/welcome_notes/{noteId}": {
      "schema": "WelcomeNote",
      "description": "Collection of user-created welcome notes and thoughts"
    }
  }
}
